@model Dictionary<string, string>
@{
    ViewData["Title"] = "Application Settings";
    string V(string key) => Model.TryGetValue(key, out var v) ? v : "";
    bool B(string key, bool def = false) => Model.TryGetValue(key, out var v) ? v == "true" : def;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear"></i> Application Settings</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Admin
        </a>
    </div>

    <div class="row">
        <!-- Email Settings -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-envelope"></i> Email Settings
                </div>
                <div class="card-body">
                    <form id="emailSettingsForm">
                        <div class="mb-3">
                            <label class="form-label">SMTP Host</label>
                            <input type="text" class="form-control" id="smtpHost" value="@V("Email:SmtpHost")" placeholder="smtp.gmail.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" class="form-control" id="smtpPort" value="@V("Email:SmtpPort")" placeholder="587">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Username</label>
                            <input type="text" class="form-control" id="smtpUsername" value="@V("Email:SmtpUsername")">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Password</label>
                            <input type="password" class="form-control" id="smtpPassword" value="@V("Email:SmtpPassword")" placeholder="(unchanged if left empty)">
                            <small class="form-text text-muted">Leave empty to keep existing password.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">From Email</label>
                            <input type="email" class="form-control" id="fromEmail" value="@V("Email:FromEmail")">
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="enableSsl" @(B("Email:EnableSsl", true) ? "checked" : "")>
                            <label class="form-check-label" for="enableSsl">Enable SSL/TLS</label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="sendOnComplete" @(B("Email:SendOnComplete", true) ? "checked" : "")>
                            <label class="form-check-label" for="sendOnComplete">Send email on scan completion</label>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Email Settings
                        </button>
                        <button type="button" class="btn btn-outline-secondary ms-2" id="testEmailBtn">
                            <i class="bi bi-send"></i> Send Test Email
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Scan Settings -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-shield-check"></i> Scan Settings
                </div>
                <div class="card-body">
                    <form id="scanSettingsForm">
                        <div class="mb-3">
                            <label class="form-label">Maximum Concurrent Scans</label>
                            <input type="number" class="form-control" id="maxConcurrentScans" value="@V("Scan:MaxConcurrent")" min="1" max="10">
                            <small class="form-text text-muted">Number of scans that can run simultaneously</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Scan Timeout (minutes)</label>
                            <input type="number" class="form-control" id="scanTimeout" value="@V("Scan:TimeoutMinutes")" min="5" max="240">
                            <small class="form-text text-muted">Maximum time allowed for a single scan</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Auto-Scan Schedule</label>
                            <select class="form-select" id="autoScanSchedule">
                                @{ var sched = V("Scan:AutoSchedule"); }
                                <option value="none" selected="@(sched=="none"?"selected":null)">Disabled</option>
                                <option value="daily" selected="@(sched=="daily"?"selected":null)">Daily</option>
                                <option value="weekly" selected="@(sched=="weekly"?"selected":null)">Weekly</option>
                                <option value="monthly" selected="@(sched=="monthly"?"selected":null)">Monthly</option>
                            </select>
                            <small class="form-text text-muted">Automatically scan repositories</small>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Save Scan Settings
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Security Settings -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <i class="bi bi-shield-lock"></i> Security Settings
                </div>
                <div class="card-body">
                    <form id="securitySettingsForm">
                        <div class="mb-3">
                            <label class="form-label">Session Timeout (minutes)</label>
                            <input type="number" class="form-control" id="sessionTimeout" value="30" min="5" max="120">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Min Length</label>
                            <input type="number" class="form-control" id="passwordMinLength" value="6" min="6" max="20">
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="requireUppercase" checked>
                            <label class="form-check-label" for="requireUppercase">
                                Require uppercase letter in password
                            </label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="requireDigit" checked>
                            <label class="form-check-label" for="requireDigit">
                                Require digit in password
                            </label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="requireNonAlphanumeric">
                            <label class="form-check-label" for="requireNonAlphanumeric">
                                Require special character in password
                            </label>
                        </div>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Save Security Settings
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Application Settings -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-sliders"></i> Application Settings
                </div>
                <div class="card-body">
                    <form id="applicationSettingsForm">
                        <div class="mb-3">
                            <label class="form-label">Application Name</label>
                            <input type="text" class="form-control" id="appName" value="Security Scan Dashboard">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Items Per Page</label>
                            <input type="number" class="form-control" id="itemsPerPage" value="10" min="5" max="100">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Log Retention Days</label>
                            <input type="number" class="form-control" id="logRetention" value="30" min="7" max="365">
                            <small class="form-text text-muted">Number of days to keep log files</small>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="enableSwagger" checked>
                            <label class="form-check-label" for="enableSwagger">
                                Enable Swagger API Documentation
                            </label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="enableDetailedErrors">
                            <label class="form-check-label" for="enableDetailedErrors">
                                Show detailed error pages (Development only)
                            </label>
                        </div>
                        <button type="submit" class="btn btn-info">
                            <i class="bi bi-save"></i> Save Application Settings
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="card bg-light">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-info-circle"></i> Important Information
            </h5>
            <ul class="mb-0">
                <li>Settings are stored in the database and persist across application restarts.</li>
                <li>Email settings take effect immediately on the next scan completion.</li>
                <li>Use the <strong>Send Test Email</strong> button to verify your SMTP configuration.</li>
                <li>Gmail users: enable 2FA and create an App Password at <a href="https://myaccount.google.com/apppasswords" target="_blank">myaccount.google.com/apppasswords</a>.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function saveSettings(payload) {
            const resp = await fetch('@Url.Action("UpdateSettings","Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                body: JSON.stringify(payload)
            });
            return await resp.json();
        }

        // Email Settings Form
        document.getElementById('emailSettingsForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const pwd = document.getElementById('smtpPassword').value;
            const payload = {
                'Email:SmtpHost':     document.getElementById('smtpHost').value,
                'Email:SmtpPort':     document.getElementById('smtpPort').value,
                'Email:SmtpUsername': document.getElementById('smtpUsername').value,
                'Email:FromEmail':    document.getElementById('fromEmail').value,
                'Email:EnableSsl':    document.getElementById('enableSsl').checked ? 'true' : 'false',
                'Email:SendOnComplete': document.getElementById('sendOnComplete').checked ? 'true' : 'false',
            };
            if (pwd) payload['Email:SmtpPassword'] = pwd;
            const r = await saveSettings(payload);
            Swal.fire({ icon: r.success ? 'success' : 'error', title: r.success ? 'Saved' : 'Error', text: r.message, timer: 2500 });
        });

        // Test Email Button
        document.getElementById('testEmailBtn').addEventListener('click', async function() {
            const { value: email } = await Swal.fire({
                title: 'Send Test Email',
                input: 'email',
                inputLabel: 'Recipient email address',
                inputPlaceholder: 'test@example.com',
                showCancelButton: true
            });
            if (!email) return;
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';
            try {
                const resp = await fetch('@Url.Action("SendTestEmail","Admin")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const r = await resp.json();
                Swal.fire({ icon: r.success ? 'success' : 'error', title: r.success ? 'Sent!' : 'Failed', text: r.message });
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send"></i> Send Test Email';
            }
        });

        // Scan Settings Form
        document.getElementById('scanSettingsForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                'Scan:MaxConcurrent':  document.getElementById('maxConcurrentScans').value,
                'Scan:TimeoutMinutes': document.getElementById('scanTimeout').value,
                'Scan:AutoSchedule':   document.getElementById('autoScanSchedule').value,
            };
            const r = await saveSettings(payload);
            Swal.fire({ icon: r.success ? 'success' : 'error', title: r.success ? 'Saved' : 'Error', text: r.message, timer: 2000 });
        });

        // Security Settings Form
        document.getElementById('securitySettingsForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                'Security:SessionTimeoutMinutes': document.getElementById('sessionTimeout').value,
                'Security:PasswordMinLength':     document.getElementById('passwordMinLength').value,
                'Security:RequireUppercase':      document.getElementById('requireUppercase').checked ? 'true' : 'false',
                'Security:RequireDigit':          document.getElementById('requireDigit').checked ? 'true' : 'false',
                'Security:RequireNonAlphanumeric':document.getElementById('requireNonAlphanumeric').checked ? 'true' : 'false',
            };
            const r = await saveSettings(payload);
            Swal.fire({ icon: r.success ? 'success' : 'error', title: r.success ? 'Saved' : 'Error', text: r.message, timer: 2500 });
        });

        // Application Settings Form
        document.getElementById('applicationSettingsForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                'App:ItemsPerPage':      document.getElementById('itemsPerPage').value,
                'App:LogRetentionDays':  document.getElementById('logRetention').value,
                'App:EnableSwagger':     document.getElementById('enableSwagger').checked ? 'true' : 'false',
            };
            const r = await saveSettings(payload);
            Swal.fire({ icon: r.success ? 'success' : 'error', title: r.success ? 'Saved' : 'Error', text: r.message, timer: 2000 });
        });
    </script>
}
