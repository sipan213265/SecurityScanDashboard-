@model SecurityScanDashboard.Models.Repository

@{
    ViewData["Title"] = "Repository Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-github"></i> @Model.Name</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-info-circle"></i> Repository Information
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Repository:</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Owner:</dt>
                        <dd class="col-sm-9">@Model.Owner</dd>

                        <dt class="col-sm-3">URL:</dt>
                        <dd class="col-sm-9"><a href="@Model.Url" target="_blank">@Model.Url</a></dd>

                        <dt class="col-sm-3">Live URL:</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.LiveUrl))
                            {
                                <a href="@Model.LiveUrl" target="_blank">@Model.LiveUrl</a>
                            }
                            else
                            {
                                <span class="text-muted">Not configured</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Added:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                        <dt class="col-sm-3">Total Scans:</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Scans.Count</span></dd>
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-shield-check"></i> Scan History
                </div>
                <div class="card-body">
                    @if (!Model.Scans.Any())
                    {
                        <p class="text-muted">No scans performed yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Tool</th>
                                        <th>Status</th>
                                        <th>Vulnerabilities</th>
                                        <th>Started</th>
                                        <th>Completed</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var scan in Model.Scans.OrderByDescending(s => s.StartedAt))
                                    {
                                        <tr>
                                            <td><span class="badge bg-info">@scan.Type</span></td>
                                            <td>@scan.ToolName</td>
                                            <td>
                                                @if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Completed)
                                                {
                                                    <span class="badge bg-success">Completed</span>
                                                }
                                                else if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Running)
                                                {
                                                    <span class="badge bg-warning">Running</span>
                                                }
                                                else if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Failed)
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pending</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-danger">@scan.Vulnerabilities.Count</span></td>
                                            <td>@scan.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@(scan.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                            <td>
                                                <a asp-controller="Scan" asp-action="Details" asp-route-id="@scan.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-play-circle"></i> Start New Scan
                </div>
                <div class="card-body">
                    <h6>SAST (Static Analysis)</h6>
                    <div class="d-grid gap-2 mb-3">
                        <button class="btn btn-outline-primary" onclick="startScan(@Model.Id, 'SAST', 'Semgrep')">
                            <i class="bi bi-shield-check"></i> Semgrep
                        </button>
                    </div>

                    <h6>DAST (Dynamic Analysis)</h6>
                    @if (!string.IsNullOrEmpty(Model.LiveUrl))
                    {
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-warning" onclick="startScan(@Model.Id, 'DAST', 'Nuclei')">
                                <i class="bi bi-bug"></i> Nuclei
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> 
                            <small>Live URL required for DAST scanning</small>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-exclamation-triangle"></i> Vulnerability Summary
                </div>
                <div class="card-body">
                    @{
                        var allVulns = Model.Scans.SelectMany(s => s.Vulnerabilities).ToList();
                        var criticalCount = allVulns.Count(v => v.Severity == SecurityScanDashboard.Models.SeverityLevel.Critical);
                        var highCount = allVulns.Count(v => v.Severity == SecurityScanDashboard.Models.SeverityLevel.High);
                        var mediumCount = allVulns.Count(v => v.Severity == SecurityScanDashboard.Models.SeverityLevel.Medium);
                        var lowCount = allVulns.Count(v => v.Severity == SecurityScanDashboard.Models.SeverityLevel.Low);
                    }
                    
                    <div class="mb-2">
                        <span class="badge bg-danger">Critical</span>
                        <strong>@criticalCount</strong>
                    </div>
                    <div class="mb-2">
                        <span class="badge bg-warning">High</span>
                        <strong>@highCount</strong>
                    </div>
                    <div class="mb-2">
                        <span class="badge bg-info">Medium</span>
                        <strong>@mediumCount</strong>
                    </div>
                    <div>
                        <span class="badge bg-secondary">Low</span>
                        <strong>@lowCount</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function startScan(repositoryId, type, tool) {
            // SweetAlert confirmation
            Swal.fire({
                title: 'Scan Başlat',
                text: `${tool} kullanarak ${type} taraması başlatmak istediğinizden emin misiniz?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Evet, Başlat!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'Scan Başlatılıyor...',
                        html: `${tool} scan'i başlatılıyor, lütfen bekleyin...`,
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        willOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    const url = type === 'SAST' ? '/Scan/StartSAST' : '/Scan/StartDAST';
                    
                    const params = new URLSearchParams();
                    params.append('repositoryId', repositoryId);
                    if (type === 'SAST') {
                        params.append('tool', tool);
                    }

                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: params.toString()
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Başarılı!',
                                text: data.message || `Scan başarıyla başlatıldı! (ID: ${data.scanId})`,
                                confirmButtonText: 'Tamam'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Hata!',
                                text: data.message || 'Scan başlatılamadı',
                                confirmButtonText: 'Tamam'
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Hata!',
                            text: 'Scan başlatılırken bir hata oluştu: ' + error.message,
                            confirmButtonText: 'Tamam'
                        });
                    });
                }
            });
        }
    </script>
}
