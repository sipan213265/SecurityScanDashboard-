@{
    ViewData["Title"] = "Sayfa Bulunamadı";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-question-circle-fill text-warning" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-1 text-warning fw-bold">404</h1>
                    <h2 class="mb-3">Sayfa Bulunamadı</h2>
                    <p class="lead text-muted mb-4">
                        Aradığınız sayfa mevcut değil veya taşınmış olabilir.
                    </p>
                    
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door"></i> Ana Sayfaya Dön
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left"></i> Geri Git
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="card mt-3 bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-lightbulb"></i> Faydalı Bağlantılar
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a></li>
                        <li><a asp-controller="Repository" asp-action="Index"><i class="bi bi-github"></i> Repositories</a></li>
                        <li><a asp-controller="Scan" asp-action="Index"><i class="bi bi-shield-check"></i> Scans</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
