@model IEnumerable<SecurityScanDashboard.Models.Scan>

@{
    ViewData["Title"] = "Scan History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shield-check"></i> Scan History</h2>
        <div>
            <button class="btn btn-warning me-2" data-bs-toggle="modal" data-bs-target="#dastScanModal">
                <i class="bi bi-bug"></i> Quick DAST Scan
            </button>
            <a asp-controller="Repository" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-github"></i> View Repositories
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No scans have been performed yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="scansTable" class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Repository</th>
                        <th>Type</th>
                        <th>Tool</th>
                        <th>Status</th>
                        <th>Vulnerabilities</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scan in Model)
                    {
                        var duration = scan.CompletedAt.HasValue 
                            ? (scan.CompletedAt.Value - scan.StartedAt).TotalMinutes.ToString("F1") + " min"
                            : "-";

                        <tr>
                            <td><strong>@scan.Repository.Name</strong></td>
                            <td>
                                <span class="badge bg-@(scan.Type == SecurityScanDashboard.Models.ScanType.SAST ? "primary" : "warning")">
                                    @scan.Type
                                </span>
                            </td>
                            <td>@scan.ToolName</td>
                            <td>
                                @if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Completed)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Running)
                                {
                                    <span class="badge bg-warning">Running</span>
                                }
                                else if (scan.Status == SecurityScanDashboard.Models.ScanStatus.Failed)
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-danger">@scan.Vulnerabilities.Count</span>
                            </td>
                            <td>@scan.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@duration</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@scan.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- DAST Scan Modal -->
<div class="modal fade" id="dastScanModal" tabindex="-1" aria-labelledby="dastScanModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="dastScanModalLabel">
                    <i class="bi bi-bug"></i> Quick DAST Scan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="dastScanForm">
                    <div class="mb-3">
                        <label for="targetUrl" class="form-label">Target URL *</label>
                        <input type="url" class="form-control" id="targetUrl" placeholder="https://example.com" required>
                        <div class="form-text">Enter the live application URL to scan</div>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <small>DAST scan will test the live application for security vulnerabilities. This may take several minutes.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="startQuickDastScan()">
                    <i class="bi bi-play-circle"></i> Start Scan
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTables
            $('#scansTable').DataTable({
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"B>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                buttons: [
                    {
                        extend: 'copy',
                        text: '<i class="bi bi-clipboard"></i> Copy',
                        className: 'btn btn-sm btn-secondary'
                    },
                    {
                        extend: 'csv',
                        text: '<i class="bi bi-filetype-csv"></i> CSV',
                        className: 'btn btn-sm btn-success'
                    },
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                        className: 'btn btn-sm btn-success'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-filetype-pdf"></i> PDF',
                        className: 'btn btn-sm btn-danger'
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer"></i> Print',
                        className: 'btn btn-sm btn-info'
                    }
                ],
                order: [[5, 'desc']], // Sort by Started date descending
                pageLength: 10
            });
        });
        
        function startQuickDastScan() {
            const targetUrl = document.getElementById('targetUrl').value;
            
            if (!targetUrl) {
                alert('Please enter a target URL');
                return;
            }
            
            if (!confirm(`Start DAST scan for ${targetUrl}?`)) {
                return;
            }
            
            const params = new URLSearchParams();
            params.append('targetUrl', targetUrl);
            
            fetch('/Scan/StartQuickDAST', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message || 'DAST scan started successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Failed to start scan'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while starting the scan: ' + error.message);
            });
        }
    </script>
}
