@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                </h2>
                
                <form asp-action="Login" asp-controller="Account" method="post">
                    <input type="hidden" asp-for="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label">Kullanıcı Adı veya E-posta</label>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="kullanici_adi veya ornek@email.com" autofocus />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="text-end mt-1">
                            <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none small text-muted">
                                Şifremi Unuttum?
                            </a>
                        </div>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Beni Hatırla</label>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                        </button>
                    </div>
                </form>
                
                <hr class="my-4">
                
                <p class="text-center text-muted mb-0">
                    Hesabınız yok mu? 
                    <a asp-action="Register" asp-controller="Account" class="text-decoration-none fw-bold">Kayıt Ol</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
