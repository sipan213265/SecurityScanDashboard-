@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-2">
                    <i class="bi bi-envelope-arrow-up me-2"></i>Şifremi Unuttum
                </h2>
                <p class="text-muted text-center small mb-4">
                    Kayıtlı email adresinizi girin, şifre sıfırlama linki gönderelim.
                </p>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Adresi</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="bi bi-send me-2"></i>Sıfırlama Linki Gönder
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Giriş sayfasına dön
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
