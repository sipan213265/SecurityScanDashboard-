@{
    ViewData["Title"] = "Email Gönderildi";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow border-success">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-envelope-check text-success" style="font-size:3rem;"></i>
                </div>
                <h2 class="card-title mb-3">Email Gönderildi</h2>
                <p class="text-muted">
                    Eğer bu email adresi sistemimizde kayıtlıysa, şifre sıfırlama linki gönderildi.
                </p>
                <p class="text-muted small">
                    Gelen kutunuzu (ve spam/gereksiz klasörünü) kontrol edin. Link <strong>1 saat</strong> geçerlidir.
                </p>
                <hr>
                <a asp-action="Login" asp-controller="Account" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Sayfasına Dön
                </a>
            </div>
        </div>
    </div>
</div>
