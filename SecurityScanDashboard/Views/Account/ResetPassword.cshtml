@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-2">
                    <i class="bi bi-key me-2"></i>Yeni Şifre Belirle
                </h2>
                <p class="text-muted text-center small mb-4">
                    En az 6 karakter içeren yeni şifrenizi girin.
                </p>

                <form asp-action="ResetPassword" asp-controller="Account" method="post">
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Yeni Şifre</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••" autofocus />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Yeni Şifreyi Onayla</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Şifremi Sıfırla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
